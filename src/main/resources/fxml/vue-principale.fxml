<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="immobilier.controller.ControleurPrincipal"
            stylesheets="@../css/style.css">

    <top>
        <VBox spacing="12" styleClass="haut">

            <Label text="Catalogue Immobilier"
                   styleClass="titre"/>

            <HBox spacing="10">

                <TextField fx:id="champRecherche"
                           promptText="Rechercher une rue ou une ville..."
                           prefWidth="400"/>

                <ComboBox fx:id="comboTri"
                          promptText="Trier par"
                          prefWidth="200"/>

            </HBox>

            <HBox spacing="10">

                <ComboBox fx:id="comboTransaction"
                          promptText="Transaction"
                          prefWidth="150"/>

                <ComboBox fx:id="comboType"
                          promptText="Type de bien"
                          prefWidth="150"/>

                <TextField fx:id="champPrixMax"
                           promptText="Prix max"
                           prefWidth="120"/>

                <ComboBox fx:id="comboChambres"
                          promptText="Chambres min"
                          prefWidth="140"/>

                <TextField fx:id="champSuperficieMin"
                           promptText="Superficie min"
                           prefWidth="140"/>

                <ComboBox fx:id="comboVille"
                          promptText="Ville"
                          prefWidth="140"/>

                <TextField fx:id="champAnneeMin"
                           promptText="Année min"
                           prefWidth="110"/>

            </HBox>

        </VBox>
    </top>

    <center>

        <HBox spacing="20" styleClass="contenu">

            <VBox spacing="10" prefWidth="780">

                <Label text="Liste des propriétés"
                       styleClass="sous-titre"/>

                <TableView fx:id="tableProprietes"
                           prefHeight="500">

                    <columns>
                        <TableColumn fx:id="colPrix"
                                     text="Prix"
                                     prefWidth="150"/>

                        <TableColumn fx:id="colType"
                                     text="Type"
                                     prefWidth="130"/>

                        <TableColumn fx:id="colVille"
                                     text="Ville"
                                     prefWidth="160"/>

                        <TableColumn fx:id="colChambres"
                                     text="Chambres"
                                     prefWidth="140"/>

                        <TableColumn fx:id="colSuperficie"
                                     text="Superficie"
                                     prefWidth="160"/>
                    </columns>

                </TableView>

                <HBox spacing="15">

                    <Button fx:id="btnPrecedent"
                            text="Précédent"/>

                    <Label fx:id="labelPage"
                           text="Page 1"/>

                    <Button fx:id="btnSuivant"
                            text="Suivant"/>

                </HBox>

            </VBox>

            <VBox spacing="15"
                  prefWidth="330"
                  styleClass="details">

                <Label text="Détails de la propriété"
                       styleClass="sous-titre"/>

                <Label fx:id="labelPrix"
                       text="Prix :"/>

                <Label fx:id="labelTransaction"
                       text="Transaction :"/>

                <Label fx:id="labelAdresse"
                       text="Adresse :"/>

                <Label fx:id="labelInfos"
                       text="Informations :"
                       wrapText="true"/>

                <Button fx:id="btnFavoris"
                        text="Ajouter aux favoris"/>

            </VBox>

        </HBox>

    </center>

</BorderPane>